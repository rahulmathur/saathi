// The web version of the Saathi app, for testers without the store apps.
// Build with `node scripts/build-web.mjs`, then deploy with `npx wrangler deploy`.
{
  "name": "saathi-app",
  "compatibility_date": "2026-10-19",
  "assets": {
    "directory": "./dist-web",
    "not_found_handling": "single-page-application"
  }
}
